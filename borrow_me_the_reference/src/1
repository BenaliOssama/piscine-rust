
pub fn do_operations(v: &mut [String]) {
    
    v = v.iter().map(|num|  // Strings
        num.clone().split("+") // iterator
        .reduce(|x, y| 
            (x.parse::<i32>().unwrap() + y.parse::<i32>().unwrap())
            .to_str()
        )
    ).collect::<Vec<String>>();

}

pub fn delete_and_backspace(s: &mut String) {
    let copy = s.clone();
    s.clear();
    let mut stack: Vec<char> = vec![];
    let mut skip : usize = 0 ; 

    for char in copy.chars() {
        if char == '-' {
            stack.pop();
        }else if char == '+' {
           skip += 1 ; 
        }else {
            if skip > 0 {
                skip -= 1 ;
                continue
            }
            stack.push(char);
        }

    }
    // convert to string and push str
    // let string : String = stack.iter().collect();
    // s.push_str(&string);
    //extend string by chars iterator
    s.extend(stack.iter()) ;
}

